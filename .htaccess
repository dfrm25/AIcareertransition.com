# AI Career Transition — caching & compression (Apache / cPanel)
# Improves PageSpeed "efficient cache" for css, js, images.

DirectoryIndex index.html index.htm

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical SEO host: force HTTPS and non-www.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.aicareertransition\.com$ [NC]
  RewriteRule ^(.*)$ https://aicareertransition.com/$1 [R=301,L]

  # One URL per directory. /index.html and /guides/index.html 301 to the slash form.
  # These hops showed up as GSC "Redirect" after 9 Jun 2026; keep the 301s, stop linking the .html form.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ https://aicareertransition.com/$1 [R=301,L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Long cache for fingerprint-free static assets; redeploy or rename files to bust cache.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(svg|png|jpg|jpeg|webp|ico|woff2|woff)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # HTML must revalidate on every request so cPanel deploys are visible immediately.
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Sitemap, robots, and feed must not sit in a long cache after a weekly refresh.
  <FilesMatch "^(sitemap\.xml|robots\.txt|feed\.xml|llms\.txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<Files "sitemap.xml">
  ForceType application/xml
</Files>
<Files "feed.xml">
  ForceType application/xml
</Files>
